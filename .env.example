# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings -> API). See MANUAL_TASKS.md for the full walkthrough.
# With these two blank/placeholder the app runs in DEMO MODE (sample data, demo accounts,
# DEMO/FALLBACK AI that is clearly labelled as not real).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The PUBLIC "anon" key (or the newer "publishable" key, sb_publishable_...).
# NEVER put the service_role / secret key here: everything prefixed VITE_ ships to the browser.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional. Demo mode (built-in fake accounts, no Supabase) is ON automatically in `npm run dev`
# when the two values above are missing. Set to "true" only if you deliberately want
# demo mode inside a production build that has no Supabase config.
VITE_ALLOW_DEMO=false

# ---------------------------------------------------------------------------------------------
# AI vision key: SERVER-SIDE ONLY. Do NOT put it in this file and do NOT prefix it with VITE_.
# The browser never sees it. It is stored as a Supabase Edge Function secret:
#
#   supabase secrets set GEMINI_API_KEY=<your key>
#   supabase secrets set GEMINI_MODEL=<optional model override, default gemini-1.5-flash>
#
# Listed here only so you know the names. Leave them out of any committed file.
# GEMINI_API_KEY=
# GEMINI_MODEL=
